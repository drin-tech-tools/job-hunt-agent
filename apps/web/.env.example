# Server-only. Do NOT prefix with NEXT_PUBLIC_ — the browser never sees this.
# On Vercel, API_URL is injected by the web→api service binding (do not set it).
# For plain `next dev` / Cucumber e2e without `vercel dev`, point at local FastAPI:
API_URL=http://127.0.0.1:8000

# Optional shared secret (must match apps/api INTERNAL_API_TOKEN when set)
# INTERNAL_API_TOKEN=

# Supabase Auth (same project as rag-doc-chatbot). Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only service role for admin invite/bootstrap (never NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Bootstrap admin (used by apps/api/scripts/bootstrap_admin.py)
# ADMIN_EMAIL=you@example.com

# Test-only auth bypass — requires AGENT_MOCK=1. NEVER on Vercel Production.
# AUTH_BYPASS=1
# AGENT_MOCK=1
# NEXT_PUBLIC_AUTH_BYPASS=1
