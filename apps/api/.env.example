# Required in production
GEMINI_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer new Secret key format (sb_secret_...); legacy service_role JWT also works
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional shared secret. When set, every request must include matching
# X-Internal-Api-Token (the Next.js BFF sends INTERNAL_API_TOKEN).
# INTERNAL_API_TOKEN=

# CORS is unused in production (API is internal-only). Harmless for local
# browser→API access (e.g. http://localhost:8000/docs).
ALLOWED_ORIGINS=http://localhost:3000

# Optional — pin a chat model; otherwise ordered fallback is used
# GEMINI_CHAT_MODEL=gemini-flash-latest

# Optional — enables JSearch stub source when set (disabled when unset)
# JSEARCH_API_KEY=

# Deterministic mock mode for local demos / Cucumber E2E (no Gemini, no live boards)
# AGENT_MOCK=1

# Guardrail tuning (optional)
# AGENT_MAX_STEPS=8
# AGENT_OVERALL_TIMEOUT_S=90
# TOOL_TIMEOUT_S=20
# JOBS_CACHE_TTL_S=3600
